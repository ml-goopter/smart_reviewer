# Copy to `.env` (that exact name — compose reads `.env`, not this file).

# AI provider ---------------------------------------------------------------
# The `openai` SDK is used as a transport only. Any OpenAI-compatible endpoint
# works by changing OPENAI_BASE_URL alone — Azure, OpenRouter, Together, Groq,
# vLLM, Ollama. Providers that are not wire-compatible (Anthropic, Gemini) need
# a new adapter implementing app.providers.base.SuggestionProvider.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Set by docker-compose; listed here for non-compose deployments -------------
# DATABASE_URL=postgresql+psycopg://reviewer:reviewer@db:5432/reviewer
#
# Trust X-Real-IP for rate limiting. Enable ONLY when a reverse proxy that
# overwrites the header is in front; otherwise clients can forge their identity.
# TRUST_PROXY_HEADERS=true

# Salts the stored IP hashes. MUST be set to a random secret in any real
# deployment: without one, an IP "hash" is reversible by brute force in seconds
# because the whole IPv4 space is only 4 billion SHA-256 calls.
IP_HASH_SALT=change-me-to-a-random-secret
